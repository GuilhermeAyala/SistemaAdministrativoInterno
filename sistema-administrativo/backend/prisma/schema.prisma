generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Colaborador {
  id        Int     @id @default(autoincrement())
  name      String
  areaCargo String
  cargo     String
  idade     Int
  salario   Decimal @db.Decimal(12, 2)
  status    String
}

model Tarefas {
  id            Int      @id @default(autoincrement())
  nome          String
  area          String
  status        String
  dataInicio    DateTime @default(now())
  dataFinal     DateTime
  atribuidoPara String
  criadoPor     String
}
